# File: .env.example

# ------------------------------------------------------------------------------
# WEB APP (Next.js)
# ------------------------------------------------------------------------------
# Found in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Found in your Supabase Project Settings -> API (Service Role)
# WARNING: Keep this secret! Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------------------
# MOBILE APP (Expo)
# ------------------------------------------------------------------------------
# These should match the public keys above.
# Expo automatically loads variables starting with EXPO_PUBLIC_
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
